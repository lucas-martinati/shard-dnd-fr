{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pack de traductions Shard D&D FR",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1
    },
    "edition": {
      "default": "any",
      "enum": [
        "2014",
        "2024",
        "any"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "en",
          "fr"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "description",
              "term"
            ],
            "default": "description"
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "fr": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "aliases": {
            "description": "Noms français alternatifs pour la recherche et la conservation des liens ou emphases : anciens noms et variantes grammaticales.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "enum": [
              "2014",
              "2024",
              "any"
            ]
          },
          "usage": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "name",
                "spell",
                "search",
                "inline"
              ]
            },
            "description": "Comportements conservés : nom bilingue, nom de sort en prose, recherche et remplacement historique en ligne."
          },
          "labelCategory": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "source"
      ]
    },
    {
      "properties": {
        "entries": {
          "items": {
            "required": [
              "source"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
